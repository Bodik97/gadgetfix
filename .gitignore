# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# але приклад конфігурації комітимо
!.env.example

# Службові файли агентських скілів (Clerk, Neon) і локальні налаштування
.agents/
.claude/

# playwright
/test-results/
/playwright-report/
# знімки й журнали браузерних перевірок (Playwright MCP)
/.playwright-mcp/
/.swc

# workflow: маршрути генеруються під час збірки
/src/app/.well-known/workflow/
/.workflow-data/
