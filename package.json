    "gsap": "^3.15.0",
    "next": "^16.3.8",
    "qrcode": "1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.170.0",
    "web-push": "^3.6.7",
    "workflow": "^5.0.1"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.42",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.170.0",
    "@types/web-push": "^3.6.4",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
